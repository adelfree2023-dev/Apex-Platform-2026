# Database Configuration
DATABASE_URL="postgresql://apex_user:secure_password@localhost:5432/apex_platform?schema=public"

# Security Configuration
JWT_SECRET="your_very_strong_jwt_secret_here_min_64_characters_for_production"
JWT_EXPIRES_IN="15m"
ENCRYPTION_MASTER_KEY="your_very_strong_encryption_master_key_here_min_64_characters_for_production"

# Application Configuration
APP_PORT=3000
APP_ENV=development
APP_DOMAIN="apex-platform.localhost"

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Tenant Configuration
DEFAULT_TENANT_PLAN="FREE"
MAX_TENANTS_PER_IP=3

# Audit Configuration
AUDIT_RETENTION_DAYS=90
