{
    "name": "@apex/core",
    "version": "0.0.1",
    "description": "Apex Platform Core - Multi-tenant Backend",
    "author": "Apex Platform Team",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main.js",
        "build:prod": "npx tsc --project tsconfig.build.json",
        "agent:scan": "node dist/src/common/security/apex-agent.js",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
        "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
        "prisma:validate": "prisma validate --schema=prisma/schema.prisma"
    },
    "dependencies": {
        "@nestjs/cache-manager": "^2.2.0",
        "@nestjs/common": "10.3.9",
        "@nestjs/config": "^3.2.0",
        "@nestjs/core": "10.3.9",
        "@nestjs/graphql": "12.0.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "10.3.9",
        "@nestjs/swagger": "7.0.0",
        "@nestjs/throttler": "5.0.0",
        "@prisma/client": "6.2.1",
        "@vendure/admin-ui-plugin": "2.1.0",
        "@vendure/asset-server-plugin": "2.1.0",
        "@vendure/core": "2.1.0",
        "bcryptjs": "2.4.3",
        "cache-manager": "^5.4.0",
        "cache-manager-redis-store": "^2.0.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.1",
        "express": "4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "8.0.0",
        "jsonwebtoken": "9.0.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "0.1.13",
        "rxjs": "7.8.1",
        "sanitize-html": "^2.11.0",
        "stripe": "16.4.0",
        "swagger-ui-express": "5.0.0",
        "uuid": "9.0.1",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@nestjs/cli": "10.3.0",
        "@nestjs/schematics": "10.1.0",
        "@nestjs/testing": "10.3.0",
        "@types/bcryptjs": "2.4.6",
        "@types/cache-manager-redis-store": "^2.0.4",
        "@types/express": "4.17.21",
        "@types/express-rate-limit": "^6.0.0",
        "@types/jest": "29.5.0",
        "@types/jsonwebtoken": "9.0.0",
        "@types/node": "20.10.0",
        "@types/sanitize-html": "^2.11.0",
        "@types/uuid": "9.0.7",
        "jest": "29.7.0",
        "jest-mock-extended": "^4.0.0",
        "prisma": "6.2.1",
        "supertest": "^6.3.3",
        "@types/supertest": "^2.0.12",
        "ts-jest": "29.1.0",
        "typescript": "5.4.5"
    }
}