### 📄 `src/common/access-control/guards/tenant-scoped.guard.spec.ts`
```typescript
import { Test, TestingModule } from '@nestjs/testing';
import { TenantScopedGuard } from './tenant-scoped.guard';
import { ExecutionContext, ForbiddenException } from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { PrismaService } from '../../../../prisma/prisma.service';
import { TenantContextService } from '../../../security/tenant-context/tenant-context.service';
import { AuditService } from '../../monitoring/audit/audit.service';

describe('TenantScopedGuard', () => {
  let guard: TenantScopedGuard;
  let prismaService: jest.Mocked<PrismaService>;
  let reflector: jest.Mocked<Reflector>;
  let tenantContextService: jest.Mocked<TenantContextService>;
  let auditService: jest.Mocked<AuditService>;
  let mockRequest: any;
  let mockContext: ExecutionContext;

  beforeEach(async () => {
    prismaService = {
      tenant: {
        findUnique: jest.fn(),
      },
      $queryRaw: jest.fn(),
      $executeRawUnsafe: jest.fn(),
    } as any;

    reflector = {
      getAllAndOverride: jest.fn(),
    } as any;

    tenantContextService = {
      setTenantId: jest.fn(),
      getTenantId: jest.fn(),
      getCurrentTenant: jest.fn(),
    } as any;

    auditService = {
      logSecurityEvent: jest.fn(),
    } as any;

    mockRequest = {
      headers: {},
      query: {},
      body: {},
      params: {},
      route: { path: '/api/test' },
      url: '/api/test',
      method: 'GET',
      ip: '1.2.3.4',
    };

    mockContext = {
      switchToHttp: () => ({
        getRequest: () => mockRequest,
      }),
      getHandler: () => ({}),
      getClass: () => ({}),
    } as unknown as ExecutionContext;

    const module: TestingModule = await Test.createTestingModule({
      providers: [
        TenantScopedGuard,
        { provide: PrismaService, useValue: prismaService },
        { provide: Reflector, useValue: reflector },
        { provide: TenantContextService, useValue: tenantContextService },
        { provide: AuditService, useValue: auditService },
      ],
    }).compile();

    guard = module.get<TenantScopedGuard>(TenantScopedGuard);
  });

  describe('canActivate', () => {
    it('يجب أن يسمح للمسارات العامة', async () => {
      reflector.getAllAndOverride.mockReturnValue(true);

      const result = await guard.canActivate(mockContext);

      expect(result).toBe(true);
    });

    it('يجب أن يرفض الطلب عندما يكون tenantId مفقوداً', async () => {
      reflector.getAllAndOverride.mockReturnValue(false);
      mockRequest.headers = {};

      await expect(guard.canActivate(mockContext)).rejects.toThrow(ForbiddenException);
      expect(auditService.logSecurityEvent).toHaveBeenCalledWith(
        'UNAUTHORIZED_TENANT_ACCESS',
        expect.objectContaining({
          reason: 'TENANT_ID_INVALID_OR_MISSING',
          path: '/api/test',
        })
      );
    });

    it('يجب أن يرفض عندما لا يوجد مستأجر', async () => {
      reflector.getAllAndOverride.mockReturnValue(false);
      mockRequest.headers['x-tenant-id'] = 'tenant-123';
      prismaService.tenant.findUnique.mockResolvedValueOnce(null);

      await expect(guard.canActivate(mockContext)).rejects.toThrow(ForbiddenException);
      expect(auditService.logSecurityEvent).toHaveBeenCalledWith(
        'UNAUTHORIZED_TENANT_ACCESS',
        expect.objectContaining({ reason: 'TENANT_INACTIVE_OR_NOT_FOUND' })
      );
    });

    it('يجب أن يرفض عندما يكون المستأجر غير نشط', async () => {
      reflector.getAllAndOverride.mockReturnValue(false);
      mockRequest.headers['x-tenant-id'] = 'tenant-123';
      prismaService.tenant.findUnique.mockResolvedValueOnce({
        id: 'tenant-123',
        status: 'inactive',
      });

      await expect(guard.canActivate(mockContext)).rejects.toThrow(ForbiddenException);
      expect(auditService.logSecurityEvent).toHaveBeenCalledWith(
        'UNAUTHORIZED_TENANT_ACCESS',
        expect.objectContaining({ reason: 'TENANT_INACTIVE_OR_NOT_FOUND' })
      );
    });

    it('يجب أن يسمح عندما يكون المستأجر نشطاً', async () => {
      reflector.getAllAndOverride.mockReturnValue(false);
      mockRequest.headers['x-tenant-id'] = 'tenant-123';
      prismaService.tenant.findUnique.mockResolvedValueOnce({
        id: 'tenant-123',
        status: 'active',
        name: 'Test Tenant',
        plan: 'FREE',
        subdomain: 'test',
      });

      prismaService.$queryRaw.mockResolvedValueOnce([{ exists: true }]);

      const result = await guard.canActivate(mockContext);

      expect(result).toBe(true);
      expect(tenantContextService.setTenantId).toHaveBeenCalledWith('tenant-123');
      expect(mockRequest.tenant).toEqual({
        id: 'tenant-123',
        name: 'Test Tenant',
        plan: 'FREE',
        subdomain: 'test',
      });
    });

    it('يجب أن ينشئ مخطط قاعدة البيانات في وضع التطوير إذا كان مفقوداً', async () => {
      process.env.NODE_ENV = 'development';
      reflector.getAllAndOverride.mockReturnValue(false);
      mockRequest.headers['x-tenant-id'] = 'tenant-123';
      prismaService.tenant.findUnique.mockResolvedValueOnce({
        id: 'tenant-123',
        status: 'active',
        name: 'Test Tenant',
      });
      prismaService.$queryRaw.mockResolvedValueOnce([{ exists: false }]);

      const result = await guard.canActivate(mockContext);

      expect(result).toBe(true);
      expect(prismaService.$executeRawUnsafe).toHaveBeenCalledWith(
        'CREATE SCHEMA IF NOT EXISTS "tenant_tenant_123";'
      );
    });
  });
});
