# 🧪 خطة إنشاء ملفات الاختبار لتغطية 95% على 5 مراحل

## المرحلة الأولى: الملفات الأساسية ونقطة الدخول

### 📄 `src/app.service.spec.ts`
```typescript
import { Test, TestingModule } from '@nestjs/testing';
import { AppService } from './app.service';
import { PrismaService } from './prisma/prisma.service';
import { ConfigService } from '@nestjs/config';
import { SecurityContext } from './common/security/security.context';
import { AuditService } from './common/monitoring/audit/audit.service';

describe('AppService', () => {
  let service: AppService;
  const mockPrisma = {
    $queryRaw: jest.fn(),
    $executeRawUnsafe: jest.fn(),
  };
  const mockConfig = { get: jest.fn().mockReturnValue('1.2.3') };
  const mockSecurity = { logSecurityEvent: jest.fn() };
  const mockAudit = { logOperation: jest.fn() };

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      providers: [
        AppService,
        { provide: PrismaService, useValue: mockPrisma },
        { provide: ConfigService, useValue: mockConfig },
        { provide: SecurityContext, useValue: mockSecurity },
        { provide: AuditService, useValue: mockAudit },
      ],
    }).compile();

    service = module.get<AppService>(AppService);
  });

  describe('getHealth()', () => {
    it('يجب أن يعيد حالة صحية بدون تفاصيل', async () => {
      mockPrisma.$queryRaw.mockResolvedValueOnce([1]); // DB health

      const health = await service.getHealth(false);

      expect(health).toMatchObject({
        status: 'ok',
        service: 'apex-core',
        timestamp: expect.any(String),
        version: '1.2.3',
        uptime: expect.any(Number),
      });
      expect(mockPrisma.$queryRaw).toHaveBeenCalled();
    });

    it('يجب أن يتضمن تفاصيل الصحة عند الطلب', async () => {
      mockPrisma.$queryRaw.mockResolvedValueOnce([1]); // DB health

      const health = await service.getHealth(true);

      expect(health).toHaveProperty('details');
      expect(health.details).toMatchObject({
        database: { status: 'healthy' },
        security: { auditLogging: true, rateLimiting: true, encryptionEnabled: true },
      });
    });

    it('يجب أن يعيد كائن خطأ عند فشل الاستعلام', async () => {
      mockPrisma.$queryRaw.mockRejectedValueOnce(new Error('Database connection failed'));

      const health = await service.getHealth();

      expect(health).toMatchObject({
        status: 'error',
        timestamp: expect.any(String),
      });
      expect(mockSecurity.logSecurityEvent).toHaveBeenCalledWith(
        'HEALTH_CHECK_FAILURE',
        expect.objectContaining({ error: 'Database connection failed' })
      );
    });
  });

  describe('verifyDatabaseConnection()', () => {
    it('يجب أن يعيد true عند نجاح الاتصال', async () => {
      mockPrisma.$queryRaw.mockResolvedValueOnce([1]);

      const result = await service.verifyDatabaseConnection();

      expect(result).toBe(true);
      expect(service['databaseConnectionVerified']).toBe(true);
    });

    it('يجب أن يعيد false ويسجل الحدث عند فشل الاتصال', async () => {
      mockPrisma.$queryRaw.mockRejectedValueOnce(new Error('Connection refused'));

      const result = await service.verifyDatabaseConnection();

      expect(result).toBe(false);
      expect(service['databaseConnectionVerified']).toBe(false);
      expect(mockSecurity.logSecurityEvent).toHaveBeenCalledWith(
        'DATABASE_CONNECTION_FAILURE',
        expect.objectContaining({ error: 'Connection refused' })
      );
    });
  });

  describe('getSecurityHealth()', () => {
    it('يجب أن يعيد حالة الأمان الصحيحة', async () => {
      const securityHealth = await service['getSecurityHealth']();

      expect(securityHealth).toEqual({
        auditLogging: true,
        rateLimiting: true,
        encryptionEnabled: true,
      });
    });
  });
});
```

### 📄 `src/app.controller.spec.ts`
```typescript
import { Test, TestingModule } from '@nestjs/testing';
import { AppController } from './app.controller';
import { AppService } from './app.service';
import { AuditService } from './common/monitoring/audit/audit.service';
import { SecurityContext } from './common/security/security.context';
import { HttpStatus, INestApplication } from '@nestjs/common';
import request from 'supertest';

describe('AppController (Integration)', () => {
  let app: INestApplication;
  const mockAppService = {
    getHealth: jest.fn().mockResolvedValue({ status: 'ok', service: 'apex-core' }),
    verifyDatabaseConnection: jest.fn().mockResolvedValue(true),
  };
  const mockAuditService = { logOperation: jest.fn() };
  const mockSecurityContext = { logSecurityEvent: jest.fn() };

  beforeAll(async () => {
    const module: TestingModule = await Test.createTestingModule({
      controllers: [AppController],
      providers: [
        { provide: AppService, useValue: mockAppService },
        { provide: AuditService, useValue: mockAuditService },
        { provide: SecurityContext, useValue: mockSecurityContext },
      ],
    }).compile();

    app = module.createNestApplication();
    await app.init();
  });

  afterAll(async () => {
    await app.close();
  });

  describe('GET /health', () => {
    it('يجب أن يعيد حالة صحية للطلب الافتراضي', async () => {
      const resp = await request(app.getHttpServer())
        .get('/health')
        .set('X-Request-ID', 'test-123')
        .expect(HttpStatus.OK);

      expect(resp.body).toMatchObject({ 
        status: 'ok', 
        service: 'apex-core',
        timestamp: expect.any(String),
        version: expect.any(String),
        uptime: expect.any(Number),
      });
      expect(mockAuditService.logOperation).toHaveBeenCalledTimes(1);
      expect(mockAuditService.logOperation).toHaveBeenCalledWith({
        action: 'HEALTH_CHECK',
        userId: 'system',
        tenantId: 'system',
        details: { service: undefined }
      });
    });

    it('يجب أن يعيد حالة صحية مع تفاصيل عند طلب includeDetails', async () => {
      mockAppService.getHealth.mockResolvedValueOnce({
        status: 'ok',
        service: 'apex-core',
        details: {
          database: { status: 'healthy' },
          security: { auditLogging: true, rateLimiting: true, encryptionEnabled: true },
        },
      });

      const resp = await request(app.getHttpServer())
        .get('/health?includeDetails=true')
        .set('X-Request-ID', 'test-123')
        .expect(HttpStatus.OK);

      expect(resp.body).toMatchObject({ 
        status: 'ok',
        details: expect.objectContaining({
          database: { status: 'healthy' },
          security: { auditLogging: true, rateLimiting: true, encryptionEnabled: true },
        })
      });
      expect(mockAppService.getHealth).toHaveBeenCalledWith(true);
    });

    it('يجب أن يعيد خطأ عند معلمات غير صالحة', async () => {
      const resp = await request(app.getHttpServer())
        .get('/health?includeDetails=invalid')
        .set('X-Request-ID', 'test-123')
        .expect(HttpStatus.BAD_REQUEST);

      expect(resp.body).toMatchObject({
        statusCode: HttpStatus.BAD_REQUEST,
        message: 'معلمات طلب التحقق من الصحة غير صالحة',
        timestamp: expect.any(String),
      });
    });
  });

  describe('GET /api/app/health', () => {
    it('يجب أن يعيد حمولة ثابتة', async () => {
      const resp = await request(app.getHttpServer())
        .get('/api/app/health')
        .expect(HttpStatus.OK);

      expect(resp.body).toEqual({
        status: 'ok',
        module: 'app-root',
        timestamp: expect.any(String),
      });
    });
  });

  describe('GET /api/infra/prisma/health', () => {
    it('يجب أن يعيد حالة صحية عند اتصال قاعدة البيانات الناجح', async () => {
      mockAppService.verifyDatabaseConnection.mockResolvedValueOnce(true);

      const resp = await request(app.getHttpServer())
        .get('/api/infra/prisma/health')
        .expect(HttpStatus.OK);

      expect(resp.body).toEqual({ 
        status: 'ok', 
        module: 'prisma-layer',
        timestamp: expect.any(String),
      });
      expect(mockAppService.verifyDatabaseConnection).toHaveBeenCalled();
    });

    it('يجب أن يعيد حالة مُتدهورة عند فشل الاتصال', async () => {
      mockAppService.verifyDatabaseConnection.mockResolvedValueOnce(false);

      const resp = await request(app.getHttpServer())
        .get('/api/infra/prisma/health')
        .expect(HttpStatus.OK);

      expect(resp.body).toEqual({ 
        status: 'degraded', 
        module: 'prisma-layer',
        timestamp: expect.any(String),
      });
      expect(mockSecurityContext.logSecurityEvent).toHaveBeenCalledWith(
        'DATABASE_HEALTH_FAILURE',
        expect.objectContaining({ ip: expect.any(String) })
      );
    });
  });

  describe('GET /api/modules/:moduleName/health', () => {
    it('يجب أن يعيد حالة صحية للوحدة', async () => {
      const moduleName = 'storefront';
      const tenantId = 'tenant-123';

      const resp = await request(app.getHttpServer())
        .get(`/api/modules/${moduleName}/health`)
        .set('x-tenant-id', tenantId)
        .expect(HttpStatus.OK);

      expect(resp.body).toEqual({
        status: 'ok',
        module: moduleName,
        timestamp: expect.any(String),
      });
      expect(mockAuditService.logOperation).toHaveBeenCalledWith({
        tenantId,
        userId: 'anonymous',
        action: 'module_health_check',
        target: moduleName,
        ip: expect.any(String),
      });
    });

    it('يجب أن يعالج الأخطاء ويسجل الحدث الأمني', async () => {
      const moduleName = 'auth';
      const tenantId = 'tenant-123';
      mockAuditService.logOperation.mockRejectedValueOnce(new Error('Log failure'));

      const resp = await request(app.getHttpServer())
        .get(`/api/modules/${moduleName}/health`)
        .set('x-tenant-id', tenantId)
        .expect(HttpStatus.OK);

      expect(resp.body).toEqual(expect.objectContaining({ status: 'error', module: moduleName }));
      expect(mockSecurityContext.logSecurityEvent).toHaveBeenCalledWith(
        'MODULE_HEALTH_FAILURE',
        expect.objectContaining({ module: moduleName, error: 'Log failure' })
      );
    });
  });
});
```

### 📄 `src/main.spec.ts`
```typescript
import { Test, TestingModule } from '@nestjs/testing';
import { INestApplication } from '@nestjs/common';
import { AppModule } from './app.module';
import { ConfigService } from '@nestjs/config';
import { Logger } from '@nestjs/common';
import request from 'supertest';
import { PrismaService } from './prisma/prisma.service';
import { SystemInitializationService } from './common/core/system-initialization.service';
import { AuditService } from './common/monitoring/audit/audit.service';
import { CSPConfig } from './common/presentation/security-headers/csp.config';

describe('Main Application (End-to-End)', () => {
  let app: INestApplication;
  let prismaService: PrismaService;
  let auditService: AuditService;
  let mockLogger: any;
  let originalEnv: NodeJS.ProcessEnv;

  beforeAll(async () => {
    originalEnv = process.env;
    process.env = {
      ...originalEnv,
      NODE_ENV: 'test',
      DATABASE_URL: 'test-db-url',
      JWT_SECRET: 'test-secret-12345678901234567890123456789012',
      ENCRYPTION_MASTER_KEY: 'test-encryption-key-12345678901234567890123456789012345678901234567890',
    };

    mockLogger = {
      log: jest.fn(),
      error: jest.fn(),
      warn: jest.fn(),
    };

    const module: TestingModule = await Test.createTestingModule({
      imports: [AppModule],
    })
    .overrideProvider(ConfigService)
    .useValue({
      get: jest.fn((key) => {
        if (key === 'PORT') return 3001;
        if (key === 'APP_VERSION') return 'test-1.0.0';
        return originalEnv[key] || process.env[key];
      }),
    })
    .overrideProvider(Logger)
    .useValue(mockLogger)
    .compile();

    app = module.createNestApplication();
    prismaService = module.get<PrismaService>(PrismaService);
    auditService = module.get<AuditService>(AuditService);

    // محاكاة اتصال قاعدة البيانات
    jest.spyOn(prismaService, '$connect').mockResolvedValue(undefined);
    
    // محاكاة التهيئة النظامية
    const systemInitService = module.get<SystemInitializationService>(SystemInitializationService);
    jest.spyOn(systemInitService, 'initializeSystem').mockResolvedValue(undefined);

    await app.init();
  });

  afterAll(async () => {
    await app.close();
    process.env = originalEnv;
  });

  it('يجب أن يبدأ التطبيق بنجاح', () => {
    expect(app).toBeDefined();
    expect(mockLogger.log).toHaveBeenCalledWith(expect.stringContaining('🚀 Apex Core is running'));
  });

  it('يجب أن يتحقق من المتغيرات البيئية عند التشغيل', () => {
    expect(mockLogger.log).toHaveBeenCalledWith(expect.stringContaining('✅ System Initialized Successfully'));
  });

  it('يجب أن يطبق رؤوس الأمان', async () => {
    const response = await request(app.getHttpServer())
      .get('/health')
      .set('X-Request-ID', 'test-123')
      .expect(HttpStatus.OK);

    // التحقق من رؤوس الأمان
    expect(response.headers['x-content-type-options']).toBe('nosniff');
    expect(response.headers['x-frame-options']).toBe('DENY');
    expect(response.headers['x-xss-protection']).toBe('1; mode=block');
    expect(response.headers['strict-transport-security']).toBe('max-age=31536000; includeSubDomains');
  });

  it('يجب أن يرفض الطلبات بدون X-Request-ID', async () => {
    await request(app.getHttpServer())
      .get('/health')
      .expect(HttpStatus.UNAUTHORIZED);
  });

  it('يجب أن يطبق حدود المعدل', async () => {
    // إرسال طلبات متعددة لاختبار حدود المعدل
    for (let i = 0; i < 1001; i++) {
      await request(app.getHttpServer())
        .get('/health')
        .set('X-Request-ID', `test-${i}`)
        .expect(i === 1000 ? HttpStatus.TOO_MANY_REQUESTS : HttpStatus.OK);
    }
  });

  it('يجب أن يسجل أحداث التدقيق', () => {
    expect(auditService.logOperation).toHaveBeenCalled();
  });

  describe('CSP Headers', () => {
    it('يجب أن يولد nonce صالح لـ CSP', async () => {
      const cspConfig = app.get<CSPConfig>(CSPConfig);
      const nonce = cspConfig.generateNonce('test-request');
      
      expect(typeof nonce).toBe('string');
      expect(nonce.length).toBeGreaterThan(10);
      expect(cspConfig.validateNonce('test-request', nonce)).toBe(true);
    });

    it('يجب أن يلغي nonce بعد انتهاء الصلاحية', async () => {
      const cspConfig = app.get<CSPConfig>(CSPConfig);
      const nonce = cspConfig.generateNonce('test-expired');
      
      // تجاوز وقت انتهاء الصلاحية
      jest.advanceTimersByTime(11 * 60 * 1000); // 11 دقيقة
      
      expect(cspConfig.validateNonce('test-expired', nonce)).toBe(false);
    });
  });
});
```

