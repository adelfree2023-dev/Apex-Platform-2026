```typescript
import { generateSecureHash, verifySecureHash } from './crypto.utils';

describe('crypto.utils', () => {
  describe('generateSecureHash', () => {
    it('يولد هاش آمنًا مع ملح', async () => {
      const password = 'mySecurePassword123!';
      const hash = await generateSecureHash(password);

      expect(hash).toContain(':');
      expect(hash.split(':')[0]).toHaveLength(32); // طول الملح
      expect(hash.split(':')[1]).toHaveLength(128); // طول الهاش
    });

    it('يولد هاشات مختلفة لنفس النص مع ملح مختلف', async () => {
      const password = 'samePassword';
      const hash1 = await generateSecureHash(password);
      const hash2 = await generateSecureHash(password);

      expect(hash1).not.toBe(hash2);
    });
  });

  describe('verifySecureHash', () => {
    it('يؤكد النصوص الصحيحة بشكل ناجح', async () => {
      const password = 'mySecurePassword123!';
      const hash = await generateSecureHash(password);
      
      const isValid = await verifySecureHash(password, hash);
      
      expect(isValid).toBe(true);
    });

    it('يرفض النصوص غير الصحيحة', async () => {
      const password = 'mySecurePassword123!';
      const wrongPassword = 'wrongPassword';
      const hash = await generateSecureHash(password);
      
      const isValid = await verifySecureHash(wrongPassword, hash);
      
      expect(isValid).toBe(false);
    });

    it('يرفض التنسيقات غير الصحيحة', async () => {
      const invalidHash = 'invalid-format';
      
      const isValid = await verifySecureHash('anyPassword', invalidHash);
      
      expect(isValid).toBe(false);
    });
  });
});
```

## المرحلة الثالثة: خدمات المتجر الأمامية (المرحلة القادمة)

* سأتبع نفس النمط لباقي الملفات في المراحل التالية، مع التركيز على:
  * تغطية الحالات المختلفة (النجاح، الفشل، الحدود)
  * محاكاة التبعيات الخارجية
  * اختبار المنطق الأساسي والفرعي
  * التحقق من السلوكيات الأمنية
  * ضمان التغطية الشاملة (95%+) للخطوط والدوال

هل تريدني أن أستمر في تنفيذ المراحل المتبقية بنفس المستوى من التفصيل؟

