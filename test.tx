### 📄 `src/modules/storefront/dto/cart-item.dto.spec.ts`

```ts
import { CartItemSchema } from './cart-item.dto';
import { z } from 'zod';

describe('CartItemDto', () => {
  it('should validate a correct cart item', () => {
    const valid = {
      productId: '123e4567-e89b-12d3-a456-426614174000',
      quantity: 2,
      price: 19.99,
      currency: 'USD',
      name: 'Product Name',
    };
    expect(() => CartItemSchema.parse(valid)).not.toThrow();
  });

  it('should reject invalid UUID', () => {
    expect(() =>
      CartItemSchema.parse({
        productId: 'invalid',
        quantity: 1,
        price: 10,
        currency: 'USD',
        name: 'X',
      })
    ).toThrow(z.ZodError);
  });

  it('should reject negative quantity', () => {
    expect(() =>
      CartItemSchema.parse({
        productId: '123e4567-e89b-12d3-a456-426614174000',
        quantity: -1,
        price: 10,
        currency: 'USD',
        name: 'X',
      })
    ).toThrow(z.ZodError);
  });

  it('should reject empty name', () => {
    expect(() =>
      CartItemSchema.parse({
        productId: '123e4567-e89b-12d3-a456-426614174000',
        quantity: 1,
        price: 10,
        currency: 'USD',
        name: '',
      })
    ).toThrow(z.ZodError);
  });
});
```

