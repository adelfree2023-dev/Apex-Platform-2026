### 📄 `src/common/access-control/guards/tenant-throttler.guard.spec.ts`
```typescript
import { Test, TestingModule } from '@nestjs/testing';
import { TenantThrottlerGuard } from './tenant-throttler.guard';
import { ExecutionContext, ForbiddenException } from '@nestjs/common';
import { RateLimiterService } from '../services/rate-limiter.service';
import { AnomalyDetectionService } from '../services/anomaly-detection.service';
import { PrismaService } from '../../../../prisma/prisma.service';
import { SecurityContext } from '../../../security/security.context';
import { ThrottlerException } from '@nestjs/throttler';

describe('TenantThrottlerGuard', () => {
  let guard: TenantThrottlerGuard;
  let rateLimiter: jest.Mocked<RateLimiterService>;
  let anomaly: jest.Mocked<AnomalyDetectionService>;
  let prisma: jest.Mocked<PrismaService>;
  let securityContext: jest.Mocked<SecurityContext>;
  let mockRequest: any;
  let mockContext: ExecutionContext;
  let mockResponse: any;

  beforeEach(async () => {
    rateLimiter = {
      consume: jest.fn(),
    } as any;

    anomaly = {
      isSuspended: jest.fn(),
      isThrottled: jest.fn(),
      inspect: jest.fn(),
    } as any;

    prisma = {
      tenant: {
        findUnique: jest.fn(),
      },
    } as any;

    securityContext = {
      logSecurityEvent: jest.fn(),
    } as any;

    mockRequest = {
      headers: {},
      route: { path: '/api/endpoint' },
      url: '/api/endpoint',
      method: 'GET',
      ip: '1.2.3.4',
    };

    mockResponse = {
      setHeader: jest.fn(),
    };

    mockContext = {
      switchToHttp: () => ({
        getRequest: () => mockRequest,
        getResponse: () => mockResponse,
      }),
      getHandler: () => ({}),
      getClass: () => ({}),
    } as unknown as ExecutionContext;

    const module: TestingModule = await Test.createTestingModule({
      providers: [
        TenantThrottlerGuard,
        { provide: RateLimiterService, useValue: rateLimiter },
        { provide: AnomalyDetectionService, useValue: anomaly },
        { provide: PrismaService, useValue: prisma },
        { provide: SecurityContext, useValue: securityContext },
      ],
    }).compile();

    guard = module.get<TenantThrottlerGuard>(TenantThrottlerGuard);
  });

  describe('canActivate', () => {
    it('يستثني مسارات التحقق من الصحة', async () => {
      mockRequest.url = '/health';

      const result = await guard.canActivate(mockContext);

      expect(result).toBe(true);
      expect(rateLimiter.consume).not.toHaveBeenCalled();
    });

    it('يحظر الطلب عندما يكون المستأجر موقوفاً', async () => {
      anomaly.isSuspended.mockReturnValue(true);
      mockRequest.headers['x-tenant-id'] = 'tenant-123';

      await expect(guard.canActivate(mockContext)).rejects.toThrow(ForbiddenException);
      expect(securityContext.logSecurityEvent).toHaveBeenCalledWith(
        'SUSPENDED_TENANT_ACCESS_ATTEMPT',
        expect.objectContaining({ tenantId: 'tenant-123' })
      );
    });

    it('يرفض عند تجاوز حد الطلبات', async () => {
      anomaly.isSuspended.mockReturnValue(false);
      mockRequest.headers['x-tenant-id'] = 'tenant-123';
      prisma.tenant.findUnique.mockResolvedValueOnce({ plan: 'FREE', status: 'active' });
      rateLimiter.consume.mockResolvedValueOnce({ allowed: false, remaining: 0, reset: 5 });

      await expect(guard.canActivate(mockContext)).rejects.toThrow(ThrottlerException);
      expect(securityContext.logSecurityEvent).toHaveBeenCalledWith(
        'RATE_LIMIT_EXCEEDED',
        expect.objectContaining({ tenantId: 'tenant-123' })
      );
    });

    it('يسمح بالطلب عندما يكون ضمن الحدود', async () => {
      anomaly.isSuspended.mockReturnValue(false);
      mockRequest.headers['x-tenant-id'] = 'tenant-123';
      prisma.tenant.findUnique.mockResolvedValueOnce({ plan: 'FREE', status: 'active' });
      rateLimiter.consume.mockResolvedValueOnce({ allowed: true, remaining: 5, reset: 0 });

      const result = await guard.canActivate(mockContext);

      expect(result).toBe(true);
      expect(mockResponse.setHeader).toHaveBeenCalledWith('X-RateLimit-Limit', expect.any(Number));
      expect(mockResponse.setHeader).toHaveBeenCalledWith('X-RateLimit-Remaining', 5);
      expect(mockResponse.setHeader).toHaveBeenCalledWith('X-RateLimit-Reset', 0);
      expect(anomaly.inspect).toHaveBeenCalledWith('tenant-123', false, expect.any(Object));
    });

    it('يحاسب المستأجر الموقوف', async () => {
      anomaly.isSuspended.mockReturnValue(true);
      mockRequest.headers['x-tenant-id'] = 'tenant-123';

      await expect(guard.canActivate(mockContext)).rejects.toThrow(ForbiddenException);
      expect(securityContext.logSecurityEvent).toHaveBeenCalledWith(
        'SUSPENDED_TENANT_ACCESS_ATTEMPT',
        expect.objectContaining({ tenantId: 'tenant-123' })
      );
    });
  });
});
```

### 📄 `src/common/security/validation/input-validator.service.spec.ts`
```typescript
import { Test, TestingModule } from '@nestjs/testing';
import { InputValidatorService } from './input-validator.service';
import { SanitizerService } from './sanitizer.service';
import { z } from 'zod';
import { BadRequestException } from '@nestjs/common';
import { AuditService } from '../../monitoring/audit/audit.service';

describe('InputValidatorService', () => {
  let service: InputValidatorService;
  let sanitizer: jest.Mocked<SanitizerService>;
  let auditService: jest.Mocked<AuditService>;

  beforeEach(async () => {
    sanitizer = {
      sanitizeObject: jest.fn(),
    } as any;

    auditService = {
      logSecurityEvent: jest.fn(),
    } as any;

    const module: TestingModule = await Test.createTestingModule({
      providers: [
        InputValidatorService,
        { provide: SanitizerService, useValue: sanitizer },
        { provide: 'SECURITY_LOGGER', useValue: auditService },
      ],
    }).compile();

    service = module.get<InputValidatorService>(InputValidatorService);

    // إعادة تعيين المخازن الافتراضية
    sanitizer.sanitizeObject.mockImplementation((obj) => obj);
  });

  describe('secureValidate', () => {
    it('يتحقق من البيانات الصالحة بنجاح', async () => {
      const schema = z.object({ name: z.string().min(2) });
      const data = { name: 'John' };

      const result = await service.secureValidate(schema, data, 'test-context');

      expect(result).toEqual(data);
      expect(sanitizer.sanitizeObject).toHaveBeenCalledWith(data);
      expect(sanitizer.sanitizeObject).toHaveBeenCalledWith(result);
    });

    it('يرفض البيانات غير الصالحة', async () => {
      const schema = z.object({ name: z.string().min(2) });
      const data = { name: 'J' };

      await expect(service.secureValidate(schema, data, 'test-context')).rejects.toThrow(BadRequestException);
      expect(auditService.logSecurityEvent).toHaveBeenCalledWith(
        'INPUT_VALIDATION_FAILURE',
        expect.objectContaining({ context: 'test-context' })
      );
    });

    it('ينظف البيانات قبل التحقق', async () => {
      const schema = z.object({ email: z.string().email() });
      const data = { email: ' user@example.com ' };
      sanitizer.sanitizeObject.mockImplementation(() => ({ email: 'user@example.com' }));

      const result = await service.secureValidate(schema, data, 'login');

      expect(result).toEqual({ email: 'user@example.com' });
    });

    it('يتعامل مع الأخطاء بشكل آمن', async () => {
      const schema = z.object({ id: z.string().uuid() });
      const data = { id: 'not-a-uuid' };

      await expect(service.secureValidate(schema, data, 'api-call')).rejects.toThrow(BadRequestException);
      expect(auditService.logSecurityEvent).toHaveBeenCalledWith(
        'INPUT_VALIDATION_FAILURE',
        expect.objectContaining({
          context: 'api-call',
          error: expect.objectContaining({
            name: 'ZodError',
            message: expect.any(String),
          }),
        })
      );
    });
  });

  describe('getTenantIdSchema', () => {
    it('يحدد مخطط tenantId الصالح', () => {
      const schema = service.getTenantIdSchema();
      const validData = { tenantId: '123e4567-e89b-12d3-a456-426614174000' };

      expect(() => schema.parse(validData)).not.toThrow();
    });

    it('يرفض tenantId غير صالح', () => {
      const schema = service.getTenantIdSchema();
      const invalidData = { tenantId: 'invalid-id' };

      expect(() => schema.parse(invalidData)).toThrow();
    });
  });
});
