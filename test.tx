### 📄 `src/modules/storefront/dto/checkout.dto.spec.ts`

```ts
import { CheckoutSchema } from './checkout.dto';
import { z } from 'zod';

describe('CheckoutDto', () => {
  const validItem = {
    productId: '123e4567-e89b-12d3-a456-426614174000',
    quantity: 1,
    price: 100,
    currency: 'EGP',
    name: 'Test Product',
  };

  const validDto = {
    items: [validItem],
    customerInfo: {
      name: 'Ali',
      email: 'ali@example.com',
      phone: '+201234567890',
    },
    shippingAddress: {
      street: '123 Main St',
      city: 'Cairo',
      country: 'Egypt',
      postalCode: '12345',
    },
    paymentMethod: 'CREDIT_CARD' as const,
    tenantId: '123e4567-e89b-12d3-a456-426614174000',
  };

  it('should accept valid checkout data', () => {
    expect(() => CheckoutSchema.parse(validDto)).not.toThrow();
  });

  it('should reject empty items', () => {
    expect(() => CheckoutSchema.parse({ ...validDto, items: [] })).toThrow(z.ZodError);
  });

  it('should reject invalid email', () => {
    expect(() =>
      CheckoutSchema.parse({
        ...validDto,
        customerInfo: { ...validDto.customerInfo, email: 'not-an-email' },
      })
    ).toThrow(z.ZodError);
  });

  it('should reject unsupported payment method', () => {
    expect(() =>
      CheckoutSchema.parse({ ...validDto, paymentMethod: 'BITCOIN' as any })
    ).toThrow(z.ZodError);
  });
});
```

