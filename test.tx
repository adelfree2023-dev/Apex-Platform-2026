### 📄 `src/common/security/validation/sanitizer.service.spec.ts`
```typescript
import { Test, TestingModule } from '@nestjs/testing';
import { SanitizerService } from './sanitizer.service';

describe('SanitizerService', () => {
  let service: SanitizerService;

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      providers: [SanitizerService],
    }).compile();

    service = module.get<SanitizerService>(SanitizerService);
  });

  describe('sanitize', () => {
    it('يثبت سلاسل نصية من حقن XSS ونص HTML', () => {
      const dirty = '<script>alert("xss")</script><b>نص</b> إضافي';
      const clean = service.sanitize(dirty);

      expect(clean).not.toContain('<script>');
      expect(clean).not.toContain('</script>');
      expect(clean).not.toContain('<b>');
      expect(clean).not.toContain('</b>');
      expect(clean).toBe('alert("xss")نص إضافي');
    });

    it('يتعامل مع النصوص الآمنة دون تغيير', () => {
      const cleanText = 'نص عادي بدون أي إشكال';
      expect(service.sanitize(cleanText)).toBe(cleanText);
    });

    it('يتعامل مع القيم غير النصية', () => {
      expect(service.sanitize(null)).toBeNull();
      expect(service.sanitize(undefined)).toBeUndefined();
      expect(service.sanitize(123 as any)).toBe(123);
      expect(service.sanitize({} as any)).toEqual({});
    });
  });

  describe('sanitizeObject', () => {
    it('يثبت الكائنات المتداخلة بشكل متكرر', () => {
      const dirtyObject = {
        name: 'Ali',
        bio: '<script>stealCookies()</script>',
        contact: {
          email: 'ali@example.com<script>moreMalicious()</script>',
          phone: '0123456789',
        },
        tags: ['<b>safetag</b>', '<img src=x onerror=alert(1)>'],
        active: true,
      };

      const cleanObject = service.sanitizeObject(dirtyObject);

      expect(cleanObject.bio).toBe('stealCookies()');
      expect(cleanObject.contact.email).toBe('ali@example.commorerMalicious()');
      expect(cleanObject.tags[1]).toBe('img src=x onerroralert(1)');
      expect(cleanObject.name).toBe('Ali');
      expect(cleanObject.active).toBe(true);
    });

    it('يتعامل مع المصفوفات', () => {
      const dirtyArray = [
        '<script>alert(1)</script>',
        { comment: '<img src=x onerror=alert(2)>' },
        'نص نظيف',
      ];

      const cleanArray = service.sanitizeObject(dirtyArray);

      expect(cleanArray[0]).toBe('alert(1)');
      expect(cleanArray[1].comment).toBe('img src=x onerroralert(2)');
      expect(cleanArray[2]).toBe('نص نظيف');
    });
  });
});
```

### 📄 `src/common/utils/security.utils.spec.ts`
```typescript
import { constantTimeDelay, safeRedactError } from './security.utils';
import { Logger } from '@nestjs/common';

jest.useFakeTimers();

describe('security.utils', () => {
  afterEach(() => {
    jest.useRealTimers();
  });

  describe('constantTimeDelay', () => {
    it('يُحدث تأخيرًا لعدد مللي ثانية محدد مع تباين عشوائي', async () => {
      const start = Date.now();
      const promise = constantTimeDelay(100);
      
      jest.advanceTimersByTime(150);
      await promise;
      
      const duration = Date.now() - start;
      expect(duration).toBeGreaterThanOrEqual(100);
      expect(duration).toBeLessThanOrEqual(300); // حد أقصى معقول مع التباين
    });

    it('يستخدم قيمة افتراضية إذا لم يتم توفير مللي ثانية', async () => {
      const promise = constantTimeDelay();
      
      jest.advanceTimersByTime(1500);
      await promise;
      
      expect(setTimeout).toHaveBeenCalledWith(expect.any(Function), expect.any(Number));
      const timerDelay = (setTimeout as jest.Mock).mock.calls[0][1];
      expect(timerDelay).toBeGreaterThanOrEqual(1000);
      expect(timerDelay).toBeLessThanOrEqual(1200);
    });
  });

  describe('safeRedactError', () => {
    it('يحذف المعلومات الحساسة من أخطاء قاعدة البيانات', () => {
      const dbError = new Error('relation "users" does not exist');
      const safeError = safeRedactError(dbError);

      expect(safeError.message).toBe('خطأ في معالجة البيانات');
      expect(safeError.name).toBe('Error');
    });

    it('يحذف المعلومات الحساسة من أخطاء Prisma', () => {
      const prismaError = new Error('Invalid `prisma.user.findUnique()` invocation');
      const safeError = safeRedactError(prismaError);

      expect(safeError.message).toBe('خطأ في خدمة البيانات');
      expect(safeError.name).toBe('Error');
    });

    it('يتعامل مع الرسائل العامة بدون تغيير', () => {
      const generalError = new Error('Invalid user credentials');
      const safeError = safeRedactError(generalError);

      expect(safeError.message).toBe('Invalid user credentials');
      expect(safeError.name).toBe('Error');
    });

    it('يتعامل بأمان مع القيم الخاطئة', () => {
      expect(safeRedactError(null)).toEqual({
        message: 'Unknown error',
        name: 'Error',
      });

      expect(safeRedactError(undefined)).toEqual({
        message: 'Unknown error',
        name: 'Error',
      });
    });
  });
});
```

